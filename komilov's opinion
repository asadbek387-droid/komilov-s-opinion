<script>
const PROJECT_FILES = {"iqtisodlab-promo.html": "", "talab-taklif.html": "", "gdp-calculator.html": "", "multiplier-effect.html": "", "comparative-advantage.html": ""};
 
(function () {
  const btn = document.getElementById('download-project-btn');
  const label = document.getElementById('download-project-label');
  if (!btn) return;
  btn.addEventListener('click', async function () {
    const originalLabel = label.textContent;
    try {
      const downloads = await claude.use('downloads');
      if (!downloads) {
        label.textContent = "Bu yerda mavjud emas — fayl kartasidan yuklang";
        setTimeout(function () { label.textContent = originalLabel; }, 2500);
        return;
      }
      label.textContent = 'Tayyorlanmoqda...';
      if (typeof JSZip === 'undefined') {
        label.textContent = "Xato — qayta urinib ko'ring";
        setTimeout(function () { label.textContent = originalLabel; }, 2500);
        return;
      }
      const zip = new JSZip();
      Object.keys(PROJECT_FILES).forEach(function (name) {
        zip.file(name, PROJECT_FILES[name], { base64: true });
      });
      const blob = await zip.generateAsync({ type: 'blob' });
      const result = await downloads.save({ filename: 'iqtisodlab-loyiha.zip', data: blob });
      if (result && result.status) {
        label.textContent = 'Yuklandi ✓';
        setTimeout(function () { label.textContent = originalLabel; }, 2000);
      }
    } catch (err) {
      if (err && err.code === 'declined') {
        label.textContent = originalLabel;
        return;
      }
      label.textContent = "Yuklab bo'lmadi";
      setTimeout(function () { label.textContent = originalLabel; }, 2500);
    }
  });
})();
 
(function () {
  async function downloadFile(filename, btnEl, labelEl) {
    const originalLabel = labelEl ? labelEl.textContent : null;
    try {
      const downloads = await claude.use('downloads');
      if (!downloads) {
        if (labelEl) { labelEl.textContent = 'Mavjud emas'; setTimeout(function () { labelEl.textContent = originalLabel; }, 2000); }
        return;
      }
      if (labelEl) labelEl.textContent = 'Tayyorlanmoqda...';
      const b64 = PROJECT_FILES[filename];
      const binary = atob(b64);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
      const blob = new Blob([bytes], { type: 'text/html' });
      const result = await downloads.save({ filename: filename, data: blob });
      if (result && result.status && labelEl) {
        labelEl.textContent = 'Yuklandi ✓';
        setTimeout(function () { labelEl.textContent = originalLabel; }, 2000);
      } else if (labelEl) {
        labelEl.textContent = originalLabel;
      }
    } catch (err) {
      if (labelEl) {
        if (err && err.code === 'declined') {
          labelEl.textContent = originalLabel;
        } else {
          labelEl.textContent = "Yuklab bo'lmadi";
          setTimeout(function () { labelEl.textContent = originalLabel; }, 2500);
        }
      }
    }
  }
 
  document.querySelectorAll('.tool-download-btn').forEach(function (btn) {
    const label = btn.querySelector('.go');
    btn.addEventListener('click', function () {
      downloadFile(btn.getAttribute('data-file'), btn, label);
    });
  });
 
  const heroBtn = document.getElementById('hero-download-btn');
  if (heroBtn) {
    heroBtn.addEventListener('click', function () {
      downloadFile(heroBtn.getAttribute('data-file'), heroBtn, heroBtn);
    });
  }
})();
</script>
